---
import { getImage } from 'astro:assets';
import ceiling from '../assets/hero/ceiling.jpg';
import ceilingMobile from '../assets/hero/ceiling-mobile.jpg';
import { site } from '../config/site';
import { canvases } from '../config/canvases';
import { plural } from '../lib/plural';

// Первый экран: настоящий снимок потолка Исы без тонировки и оффер — что, где и почему у мастера.
// Фото два: на компьютере — горизонтальное src/assets/hero/ceiling.jpg (от 1600 px по ширине),
// на телефоне — вертикальное ceiling-mobile.jpg: оно стоит сверху, а текст лежит под ним и не закрывает потолок.
// Заголовок разбит на строки, строки — на слова: каждое слово «натягивается» по ширине при загрузке.
const lines = ['Натяжные потолки,', 'на которые', 'хочется смотреть'];
const minPrice = Math.min(...canvases.map((c) => c.price));

const facts = [
  { title: `от ${minPrice} ₽`, note: 'за м² полотна — цены открыто' },
  { title: 'Замер бесплатно', note: 'приеду и посчитаю на месте' },
  { title: `Гарантия ${site.guaranteeYears} ${plural(site.guaranteeYears, ['год', 'года', 'лет'])}`, note: 'на выполненную работу' },
  { title: '5+ лет опыта', note: 'работал в городах России' },
];

const mobile = await getImage({ src: ceilingMobile, widths: [480, 720, 1080], format: 'webp', quality: 80 });
const desktop = await getImage({ src: ceiling, widths: [1024, 1600], format: 'webp', quality: 86 });

let word = 0;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <picture>
      <source media="(min-width: 64rem)" srcset={desktop.srcSet.attribute} sizes="100vw" type="image/webp" />
      <img
        src={mobile.src}
        srcset={mobile.srcSet.attribute}
        sizes="100vw"
        width={ceilingMobile.width}
        height={ceilingMobile.height}
        alt="Натяжной потолок со световыми контурами вокруг люстры — работа Исы"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-photo"
      />
    </picture>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container-page hero-body">
    <h1 id="hero-title" class="hero-title">
      <span class="sr-only">Santlada — натяжные потолки {site.baseCityIn} и по Дагестану. </span>
      {
        lines.map((line) => (
          <span class="hero-line" aria-hidden="true">
            {line.split(' ').map((w) => (
              <span class="hero-word" style={`--w:${word++}`}>{w}</span>
            ))}
          </span>
        ))
      }
      <span class="sr-only">{lines.join(' ')}</span>
    </h1>

    <p class="hero-lead hero-in" style="--d:0">
      Матовые, парящие, теневые и со световыми линиями. Сам замеряю, проектирую и монтирую — {site.baseCityIn} и по всему
      Дагестану.
    </p>

    <div class="hero-actions hero-in" style="--d:1">
      <a href="#kontakty" class="btn-primary btn-shine hero-cta" data-magnet>Бесплатный замер</a>
      <a href="#raboty" class="btn-ghost hero-more">Смотреть работы</a>
    </div>

    <ul class="hero-facts hero-in" style="--d:2">
      {
        facts.map((f) => (
          <li>
            <strong>{f.title}</strong>
            <span>{f.note}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
