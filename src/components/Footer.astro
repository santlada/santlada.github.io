---
import Logo from './Logo.astro';
import { IconPhone, IconTelegram, IconWhatsApp } from './icons';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<!-- Подвал — последняя синяя панель; внизу название во всю ширину -->
<footer class="site-footer">
  <div class="container-page grid gap-10 pt-14 pb-8 md:grid-cols-[1.4fr_1fr_1fr] lg:pt-20">
    <div>
      <Logo />
      <p class="mt-4 max-w-sm text-[0.9375rem] text-ink-soft">
        {site.master}, натяжные потолки {site.baseCityIn} и по всему Дагестану. Замер бесплатный.
      </p>
    </div>

    <div>
      <h2 class="font-display text-[0.9375rem] font-medium">Связаться</h2>
      <ul class="mt-4 grid gap-2.5 text-[0.9375rem]">
        <li>
          <a href={`tel:+${site.phoneDigits}`} class="inline-flex items-center gap-2 hover:underline">
            <IconPhone size={18} />
            {site.phone}
          </a>
        </li>
        <li>
          <a href={waLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:underline">
            <IconWhatsApp size={18} />
            WhatsApp
          </a>
        </li>
        <li>
          <a href={site.telegram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:underline">
            <IconTelegram size={18} />
            Telegram-канал с работами
          </a>
        </li>
        {
          site.instagram && (
            <li>
              <a href={site.instagram} target="_blank" rel="noopener" class="hover:underline">
                Instagram
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-[0.9375rem] font-medium">На сайте</h2>
      <ul class="mt-4 grid gap-2.5 text-[0.9375rem] text-ink-soft">
        <li><a href={`${base}#ceny`} class="hover:text-white">Полотна и цены</a></li>
        <li><a href={`${base}#raboty`} class="hover:text-white">Работы</a></li>
        <li><a href={`${base}#do-posle`} class="hover:text-white">До и после</a></li>
        <li><a href={`${base}#voprosy`} class="hover:text-white">Частые вопросы</a></li>
      </ul>
    </div>
  </div>

  <p class="footer-mark" aria-hidden="true">{site.brand}</p>

  <div class="container-page flex flex-col gap-2 border-t border-line py-5 text-[0.8125rem] text-ink-soft sm:flex-row sm:justify-between">
    <p>© {year} {site.brand}</p>
    <p>{site.workDays}</p>
  </div>
</footer>
