---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IconWhatsApp } from './icons';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

// Фото мастера: положите снимок в src/assets/master/ (jpg, png или webp, вертикальный, от 1000 px по высоте) —
// он сам появится справа от текста. Пока папка пустая, блок показывает только текст.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/master/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const photo = Object.values(photos)[0]?.default;
const wa = waLink('Здравствуйте! Пишу с сайта по поводу натяжного потолка.');
---

<section id="master" class="page scroll-mt-20" data-tone="blue" data-reveal aria-labelledby="master-title">
  <div
    class:list={[
      'container-page grid grid-cols-[minmax(0,1fr)] gap-10 py-20 lg:py-32',
      photo && 'lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-center lg:gap-16',
    ]}
  >
    <div data-rise>
      <h2 id="master-title" class="h-section">Кто будет делать ваш потолок</h2>
      <div class="mt-5 grid max-w-xl gap-4 text-[1.0625rem] leading-relaxed">
        <p>
          Я — {site.master}, занимаюсь натяжными потолками {site.experience}. От замера до последнего светильника всё
          делаю сам, поэтому и за результат отвечаю сам.
        </p>
        <p class="text-ink-soft">
          Раньше выезжал на работы по России и делал потолки в больших городах. Сейчас работаю во всех городах и сёлах
          Дагестана, база — {site.baseCityIn}. На замер приезжаю бесплатно, куда бы ни ехать.
        </p>
      </div>
      <a href={wa} target="_blank" rel="noopener" class="btn-primary mt-8">
        <IconWhatsApp size={18} />
        Написать в WhatsApp
      </a>
    </div>

    {
      photo && (
        <Image
          src={photo}
          alt={`${site.master} — мастер по натяжным потолкам`}
          widths={[420, 640, 900]}
          sizes="(min-width: 1024px) 440px, 100vw"
          format="webp"
          quality={80}
          class="aspect-[4/5] w-full max-w-md rounded-[var(--radius-card)] object-cover lg:justify-self-end"
        />
      )
    }
  </div>
</section>
