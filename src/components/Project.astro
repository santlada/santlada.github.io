---
import { extras, steps } from '../config/site';

// Как проходит заказ: шаги от первого сообщения до гарантии и что можно добавить к потолку.
// Шаги и дополнения — src/config/site.ts (steps, extras).
---

<section id="proekt" class="page scroll-mt-20" data-tone="white" data-reveal aria-labelledby="proekt-title">
  <div class="container-page py-20 lg:py-32">
    <div class="max-w-2xl" data-rise>
      <h2 id="proekt-title" class="h-section">Как проходит заказ</h2>
      <p class="lead mt-3">Пять шагов от первого сообщения до готового потолка.</p>
    </div>

    <ol id="kak" class="relative mt-10 grid scroll-mt-24 gap-8 lg:mt-14 lg:grid-cols-5 lg:gap-6">
      {
        steps.map((step, i) => (
          <li class="relative grid grid-cols-[2.75rem_1fr] content-start gap-4 lg:grid-cols-1 lg:gap-5">
            <div class="relative flex flex-col items-center lg:flex-row">
              <span class="relative z-10 grid size-11 shrink-0 place-items-center rounded-full bg-brand font-display text-[0.9375rem] font-semibold text-white">
                {i + 1}
              </span>
              {i < steps.length - 1 && (
                <span
                  class="absolute top-11 bottom-[-2rem] left-1/2 w-px -translate-x-1/2 bg-mist lg:top-1/2 lg:right-[-1.5rem] lg:bottom-auto lg:left-11 lg:h-px lg:w-auto lg:translate-x-0"
                  aria-hidden="true"
                  data-rise="line"
                  style={`--i:${i}`}
                />
              )}
            </div>
            <div>
              <h3 class="text-[1.0625rem] font-semibold">{step.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-14 grid gap-4 border-t border-line pt-10 lg:mt-16 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-10">
      <div>
        <h3 class="text-[1.125rem] font-semibold">Что можно добавить к потолку</h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">
          Посоветую на замере — с учётом мебели, окон и проводки. Цена дополнений зависит от проекта.
        </p>
      </div>
      <ul class="flex flex-wrap content-start gap-2">
        {extras.map((x) => <li class="inline-flex min-h-10 items-center rounded-full px-4 text-[0.9375rem] ring-1 ring-mist ring-inset">{x}</li>)}
      </ul>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href="#kontakty" class="btn-primary">Записаться на замер</a>
    </div>
  </div>
</section>
