---
import { site } from '../config/site';

interface Props {
  class?: string;
  subtitle?: boolean;
}
const { class: className = '', subtitle = true } = Astro.props;
const base = import.meta.env.BASE_URL;
// У каждого логотипа свой градиент: цвет луча берётся от текста именно этого логотипа
const beam = `logo-beam-${Math.random().toString(36).slice(2, 8)}`;
---

<!--
  Знак с фирменного логотипа: линия потолка, светильник с лучом и золотой край стены.
  Линии и луч — цветом текста (белые на фото и синих панелях, тёмные на белом), край стены — золотой.
  Рядом — название широкой разреженной гарнитурой и тонкая подпись, как на оригинале.
-->
<a href={base} class:list={['group inline-flex items-center gap-3 rounded-lg', className]} aria-label={`${site.brand} — на главную`}>
  <svg width="58" height="35" viewBox="0 0 80 48" aria-hidden="true" class="shrink-0 overflow-visible">
    <defs>
      <linearGradient id={beam} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.6"></stop>
        <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <!-- линия потолка: толстая, от левого угла к верхнему -->
    <path d="M2.5 32 54 6.5" fill="none" stroke="currentColor" stroke-width="3.2"></path>
    <!-- тонкая линия плоскости -->
    <path d="M3 34 27 41.5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
    <!-- золотой край: вдоль стены вниз -->
    <path d="M54 6.5 76 16.5V43" fill="none" stroke="var(--color-gold)" stroke-width="3.2" stroke-linejoin="miter"></path>
    <!-- светильник и его луч -->
    <path d="M29.6 23.4h4.8L42 43H22Z" fill={`url(#${beam})`}></path>
    <ellipse cx="32" cy="22.4" rx="3" ry="1.2" fill="currentColor"></ellipse>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.125rem] font-normal tracking-[0.16em]">{site.brand}</span>
    {subtitle && <span class="mt-1.5 text-[0.625rem] tracking-[0.3em] text-ink-soft uppercase">натяжные потолки</span>}
  </span>
</a>
