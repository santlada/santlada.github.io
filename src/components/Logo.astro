---
import { site } from '../config/site';

interface Props {
  class?: string;
  subtitle?: boolean;
}
const { class: className = '', subtitle = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!--
  Знак с фирменного логотипа: белая световая балка потолка, золотая световая линия под ней,
  светильник и золотой край стены. Балка и светильник — цветом текста (белые на фото и синих панелях,
  тёмные на белом), золото — всегда золотое.
  Рядом — название широкой разреженной гарнитурой и тонкая подпись, как на оригинале.
-->
<a href={base} class:list={['group inline-flex items-center gap-3 rounded-lg', className]} aria-label={`${site.brand} — на главную`}>
  <svg width="58" height="35" viewBox="0 0 80 48" aria-hidden="true" class="shrink-0 overflow-visible">
    <!-- балка потолка: от левого угла к верхнему -->
    <path d="M2 31.4 62.8 3.2V8.9L3.9 32.1Z" fill="currentColor"></path>
    <!-- золотая световая линия под балкой -->
    <path d="M9.8 33.9 60.2 13.3 61.5 14.2 13.1 34.5Z" fill="var(--color-gold)"></path>
    <!-- едва заметный край плоскости -->
    <path d="M13.1 34.9 38 42.8" fill="none" stroke="currentColor" stroke-width="0.7" stroke-linecap="round" opacity="0.35"></path>
    <!-- светильник -->
    <ellipse cx="44.2" cy="30.1" rx="4.4" ry="2" fill="currentColor"></ellipse>
    <!-- золотой край: вдоль стены вниз -->
    <path d="M62.9 3.2 78.1 13.3V44.8H73.3V15.8L62.9 8.9Z" fill="var(--color-gold)"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.125rem] font-normal tracking-[0.16em]">{site.brand}</span>
    {subtitle && <span class="mt-1.5 text-[0.625rem] tracking-[0.3em] text-ink-soft uppercase">натяжные потолки</span>}
  </span>
</a>
