---
import QuickMeasure from './QuickMeasure';
import { IconPhone, IconTelegram, IconWhatsApp } from './icons';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';
---

<section id="kontakty" class="page scroll-mt-20" data-tone="white" data-reveal aria-labelledby="kontakty-title">
  <div class="container-page grid py-20 lg:py-32 grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
    <div data-rise="left">
      <h2 id="kontakty-title" class="h-section">Запишитесь на бесплатный замер</h2>
      <p class="lead mt-3">
        Заявка придёт мне в WhatsApp. Я отвечу, и договоримся, в какой день приехать.
      </p>
      <ul class="mt-8 grid gap-3">
        <li>
          <a href={`tel:+${site.phoneDigits}`} class="group inline-flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-plane text-brand ring-1 ring-mist"><IconPhone size={20} /></span>
            <span>
              <span class="block text-[0.875rem] text-ink-soft">Позвонить</span>
              <span class="font-semibold group-hover:underline">{site.phone}</span>
            </span>
          </a>
        </li>
        <li>
          <a href={waLink()} target="_blank" rel="noopener" class="group inline-flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-plane text-wa ring-1 ring-mist"><IconWhatsApp size={20} /></span>
            <span>
              <span class="block text-[0.875rem] text-ink-soft">Есть вопрос</span>
              <span class="font-semibold group-hover:underline">Написать в WhatsApp</span>
            </span>
          </a>
        </li>
        <li>
          <a href={site.telegram} target="_blank" rel="noopener" class="group inline-flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-plane text-brand ring-1 ring-mist"><IconTelegram size={20} /></span>
            <span>
              <span class="block text-[0.875rem] text-ink-soft">Новые работы</span>
              <span class="font-semibold group-hover:underline">Telegram-канал</span>
            </span>
          </a>
        </li>
      </ul>
      <p class="mt-6 text-[0.9375rem] text-ink-soft">{site.workDays}.</p>
    </div>

    <div class="rounded-[var(--radius-media)] bg-haze p-5 sm:p-7">
      <QuickMeasure client:load />
    </div>
  </div>
</section>
